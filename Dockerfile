# Generated by Autore CLI — Multi-stage Java 21 Dockerfile (Auto-detect Maven / Gradle / JDK polos)
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY . .
RUN mkdir -p /out && \
    if [ -f pom.xml ]; then \
        mvn -B test package && cp target/*.jar /out/app.jar; \
    elif [ -f gradlew ]; then \
        chmod +x gradlew && ./gradlew test bootJar --no-daemon && cp build/libs/*.jar /out/app.jar; \
    elif [ -f Main.java ]; then \
        javac -d /out Main.java; \
    else \
        echo "Tidak ada pom.xml / gradlew / Main.java di folder ini" >&2 && exit 1; \
    fi

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /out /app
# Tambal paket OS di stage runtime (hanya stage ini yang dikirim & dipindai Trivy).
# Terukur: tanpa ini, apt bawaan punya CVE-2026-109518 HIGH (2.4.14 -> 2.4.15ubuntu0.1).
RUN apt-get update \
    && apt-get -y upgrade \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home appuser
USER appuser
EXPOSE 8080
CMD ["sh", "-c", "if [ -f app.jar ]; then exec java -jar app.jar; elif [ -f Main.class ]; then exec java -cp /app Main; else echo 'Artefak Java tidak ditemukan di /app' >&2; exit 1; fi"]
